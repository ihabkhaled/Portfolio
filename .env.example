# ── Public env (bundled into the client, must never contain secrets) ──────────
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: public mailto address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Server-only env (never exposed to the client bundle) ─────────────────────
SERVER_API_BASE_URL=http://localhost:4000
# When "enabled", the BFF gateway serves local fixtures instead of proxying to
# SERVER_API_BASE_URL. Keeps the reference app runnable without a backend.
SERVER_API_MOCKING=enabled

# Optional GitHub token. Raises the public API rate limit for the curated
# repository panel. Read on the server only and never sent to the browser.
# A fine-grained token with NO scopes is sufficient for public metadata.
GITHUB_TOKEN=

# ── Contact form (SMTP) ──────────────────────────────────────────────────────
# Disabled by default: the endpoint returns 503 and no transport is created.
# When enabled, FROM/TO/HOST/USER/PASS must all be set or the app refuses to
# boot. Put real values in .env (git-ignored) or your host's secret store —
# never in this file.
CONTACT_EMAIL_ENABLED=false
CONTACT_EMAIL_PROVIDER=smtp
# Must be a sender address verified with your SMTP provider.
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_SMTP_HOST=
# 587 uses STARTTLS (CONTACT_SMTP_SECURE=false); use 465 with secure=true.
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
